{
  "name": "sudsqueue",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "icons": "node scripts/make-icons.mjs",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
