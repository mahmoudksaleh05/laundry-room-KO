# Server (Vercel → Project → Settings → Environment Variables). Required in production.
DATABASE_URL=                  # Supabase → Connect → Transaction pooler (port 6543) URI. Unset = local SQLite file
ADMIN_PIN=0000                 # opens admin mode on a device for 8 hours; use 6+ digits
CRON_SECRET=dev-cron           # long random string; the same value goes in supabase/laundry.sql
VAPID_SUBJECT=mailto:you@example.com

# Optional
VAPID_PUBLIC=                  # push keys; generated and stored in the DB on first run if empty
VAPID_PRIVATE=
TZ_NAME=Europe/Budapest        # dorm time zone
DEMO=0                         # 1 = admins can move the clock forward (never in production)

# Client (read at build time, so set them in Vercel too). Unset = the app polls instead of live updates.
VITE_SUPABASE_URL=             # https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=        # Supabase → Project Settings → API Keys → publishable / anon key

# Local dev only
DATA_DIR=./data                # SQLite file when DATABASE_URL is unset
API_PORT=3000
