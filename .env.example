# Required in production (NODE_ENV=production). Dev falls back to the defaults shown.
DORM_CODE=SUDS                 # residents type this to sign up; admins can rotate it in the app
ADMIN_PIN=0000                 # opens admin mode on a device for 8 hours; use 6+ digits
VAPID_SUBJECT=mailto:you@example.com

# Optional
TZ_NAME=UTC                    # dorm time zone for quiet hours, e.g. Europe/Berlin
VAPID_PUBLIC=                  # push keys; generated and stored in the DB on first boot if empty
VAPID_PRIVATE=
DATA_DIR=./data                # SQLite file + daily backups
PORT=3000
API_PORT=                      # dev only: overrides PORT when a tool sets PORT for Vite
DEMO=0                         # 1 = admins can move the clock forward (never in production)
